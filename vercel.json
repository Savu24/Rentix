{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/invoices/pdf/route.ts": { "maxDuration": 60 },
    "src/app/api/invoices/[id]/pdf/route.ts": { "maxDuration": 30 },
    "src/app/api/leases/[id]/pdf/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/billing/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 4 * * *"
    }
  ]
}
