// Rentix — schemat bazy danych
//
// ── Decyzje przekrojowe ─────────────────────────────────────────────────────
//
// 1. PIENIĄDZE W GROSZACH (Int). Wszystkie kwoty to liczby całkowite groszy,
//    nigdy Float. 2 400,00 zł = 240000. Powód: arytmetyka zmiennoprzecinkowa
//    gubi grosze przy sumowaniu (0.1 + 0.2 !== 0.3), a to dane rozliczeniowe.
//    Sufiks `Grosze` jest w nazwie każdego pola, żeby nikt nie pomylił jednostki.
//    Sufit Int to 21 474 836 zł na pojedyncze pole — z zapasem wystarcza.
//
// 2. GRANICĄ IZOLACJI JEST organizationId. Każda tabela domenowa nosi je wprost,
//    nawet gdy dałoby się je wywnioskować przez relację. Dzięki temu każde
//    zapytanie zawęża się jednym warunkiem, a nie łańcuchem joinów — i nie da
//    się przypadkiem napisać zapytania bez zawężenia.
//
// 3. WIELKOŚCI FIZYCZNE JAKO Decimal. Powierzchnia i odczyty liczników to
//    Decimal, nie Int — odczyt wody ma trzy miejsca po przecinku i wchodzi
//    w mnożenie przez taryfę, więc zaokrąglenie na wejściu byłoby błędem.
//
// 4. KSeF: model Invoice trzyma dane w rozbiciu wymaganym przez strukturę FA(2)
//    (numer, data wystawienia, data sprzedaży, dane nabywcy w migawce, pozycje
//    ze stawką VAT netto/VAT/brutto). Integracji NIE MA — są tylko pola
//    `ksef*`, żeby jej dołożenie nie wymagało przebudowy modelu.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// Konta, organizacje, uwierzytelnianie
// ═══════════════════════════════════════════════════════════════════════════

/// Rola globalna użytkownika — decyduje, do którego panelu trafia po zalogowaniu.
enum UserRole {
  OWNER // właściciel / zarządca nieruchomości
  TENANT // najemca
  ADMIN // administrator platformy
}

/// Rola w obrębie jednej organizacji (zespoły).
enum MembershipRole {
  OWNER // założyciel konta, pełne uprawnienia + rozliczenia
  ADMIN // pełne uprawnienia operacyjne
  MEMBER // ograniczony dostęp
}

model Organization {
  id   String @id @default(cuid())
  name String
  /// Unikalny identyfikator w URL-ach i na publicznej stronie ofert: /o/<slug>
  slug String @unique

  /// Adres kontaktowy wynajmującego, wstawiany w powiadomieniach jako Reply-To.
  ///
  /// Wiadomości wychodzą z adresu platformy, bo tylko jej domena ma rekordy SPF
  /// i DKIM. Bez tego pola najemca odpisywałby na skrzynkę platformy zamiast do
  /// swojego wynajmującego — czyli w próżnię.
  contactEmail String?

  /// Nazwa w polu nadawcy powiadomień, gdy ma się różnić od nazwy organizacji.
  ///
  /// Nazwa firmy na fakturze bywa urzędowa („Miret sp. z o.o."), a w skrzynce
  /// najemcy lepiej wygląda ta, którą zna z rozmów. Puste pole = nazwa
  /// organizacji.
  senderName String?

  /// Ile dni przed terminem wysłać przypomnienie o zbliżającej się płatności.
  reminderDaysBefore Int @default(7)

  /// Co ile dni ponawiać wezwanie po terminie. Codzienna wiadomość o tej samej
  /// zaległości trafia do spamu i przestaje działać, stąd dolna granica
  /// pilnowana walidacją, a nie tylko wartością domyślną.
  overdueRepeatDays Int @default(7)

  // Dane wystawcy faktur — sprzedawca w rozumieniu FA(2).
  taxId       String? // NIP
  street      String?
  postalCode  String?
  city        String?
  countryCode String  @default("PL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             Membership[]
  properties          Property[]
  propertyOwners      PropertyOwner[]
  rooms               Room[]
  tenants             Tenant[]
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]
  meterReadings       MeterReading[]
  maintenanceRequests MaintenanceRequest[]
  messageThreads      MessageThread[]
  messages            Message[]
  documents           Document[]
  notifications       Notification[]
  emailTemplates      EmailTemplate[]
  subscription        Subscription?
  logo                OrganizationLogo?

  @@index([createdAt])
  @@map("organizations")
}

/// Logo wystawcy drukowane na dokumentach.
///
/// Osobna tabela, a nie kolumna w `Organization`: obrazek waży setki kilobajtów,
/// a `organization: true` w zapytaniach Prismy pobiera wszystkie kolumny naraz.
/// Trzymany obok nazwy i NIP-u dokładałby ten balast każdemu zapytaniu, które
/// o logo nie prosi — a prosi o nie tylko renderer PDF-a i podgląd w ustawieniach.
model OrganizationLogo {
  /// Klucz główny jest jednocześnie kluczem obcym: jedna organizacja, jedno logo.
  organizationId String @id

  /// Obrazek jako data URI („data:image/png;base64,…"). Trafia wprost do
  /// <Image> renderera PDF-a i do <img> w podglądzie, bez pośredniej trasy
  /// serwującej plik — a przy jednym obrazku na organizację nie ma czego
  /// oszczędzać na osobnym magazynie plików.
  dataUrl  String @db.Text
  /// PNG albo JPEG — tylko te formaty renderer PDF-a rysuje. SVG i WebP
  /// zniknęłyby z dokumentu po cichu, dlatego walidacja ich nie wpuszcza.
  mimeType String

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_logos")
}

/// Powiązanie użytkownik ↔ organizacja. W MVP właściciel ma jedno członkostwo,
/// ale model od początku dopuszcza wielu użytkowników na koncie.
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  phone String?
  image String?

  /// NULL dla kont z OAuth — logowanie hasłem jest wtedy niedostępne.
  passwordHash String?

  role          UserRole  @default(OWNER)
  emailVerified DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  /// Profil najemcy, jeśli to konto należy do najemcy.
  tenantProfile Tenant?

  reportedRequests    MaintenanceRequest[] @relation("MaintenanceReporter")
  assignedRequests    MaintenanceRequest[] @relation("MaintenanceAssignee")
  sentMessages        Message[]
  uploadedDocuments   Document[]
  notifications       Notification[]

  @@index([role])
  @@map("users")
}

/// Konto u zewnętrznego dostawcy (Google, Apple…). Nieużywane, ale wymagane
/// przez PrismaAdapter i gotowe na OAuth bez migracji.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Logowanie hasłem korzysta z JWT (wymóg Credentials), więc ta tabela zostaje
/// pusta — jest pod przyszłe OAuth i unieważnianie sesji po stronie serwera.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Tokeny jednorazowe: weryfikacja e-maila, reset hasła, zaproszenia.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════
// Nieruchomości i jednostki
// ═══════════════════════════════════════════════════════════════════════════

enum PropertyType {
  APARTMENT // mieszkanie
  HOUSE // dom
  ROOM // pokój
  COMMERCIAL // lokal użytkowy
  PARKING // miejsce postojowe
  STORAGE // komórka lokatorska
  BUILDING // cały budynek (wiele jednostek)
}

/// Status przedmiotu najmu — nieruchomości albo pojedynczego pokoju.
enum RentalStatus {
  AVAILABLE // wolne, do wynajęcia
  OCCUPIED // wynajęte
  UNAVAILABLE // wyłączone (remont, użytek własny)
}

/// Właściciel lokalu przy podnajmie i zarządzaniu.
///
/// Osobny byt od `User` i od `Tenant`: to człowiek spoza systemu, którego
/// mieszkanie obsługujemy. Nie ma konta, nie loguje się i nie jest stroną
/// umowy z najemcą — przy podnajmie wynajmującym jest użytkownik Rentiksa.
model PropertyOwner {
  id             String @id @default(cuid())
  organizationId String

  /// Jedno pole na osobę i na firmę. Rozbicie na imię i nazwisko wymuszałoby
  /// wpisywanie spółki w pole „imię", a właścicielem bywa i jedno, i drugie.
  name  String
  taxId String?

  email String?
  phone String?

  street     String?
  postalCode String?
  city       String?

  /// Rachunek, na który przekazujemy czynsz po potrąceniu prowizji.
  bankAccount String?

  /// Okres umowy o zarządzanie zawartej z właścicielem — nie mylić z umową
  /// najmu, którą podpisuje najemca (`Lease`). Obie daty opcjonalne:
  /// właściciela wpisuje się często zanim umowa zostanie podpisana,
  /// a NULL w `contractEndDate` znaczy czas nieokreślony.
  contractStartDate DateTime?
  contractEndDate   DateTime?

  notes String? @db.Text

  /// Archiwizacja zamiast usuwania — nieruchomości i ich historia zostają.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   Property[]

  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, name])
  @@map("property_owners")
}

/// Nieruchomość — i jednocześnie przedmiot najmu.
///
/// Nie ma osobnej warstwy „jednostek": mieszkanie JEST jednostką najmu.
/// Wynajmuje się je albo w całości (umowa wskazuje samą nieruchomość),
/// albo pokój po pokoju (umowa wskazuje dodatkowo `Room`).
model Property {
  id             String       @id @default(cuid())
  organizationId String
  /// NULL = nieruchomość własna. Ustawione = obsługujemy cudzy lokal
  /// (podnajem albo zarządzanie).
  ownerId        String?
  name           String
  type           PropertyType @default(APARTMENT)
  status         RentalStatus @default(AVAILABLE)

  street         String
  buildingNumber String
  /// Numer lokalu w budynku. NULL dla domu i budynku w całości — tam numer
  /// mieszkania po prostu nie istnieje, a pusty string udawałby, że go pominięto.
  apartmentNumber String?
  postalCode     String
  city           String
  countryCode    String  @default("PL")
  district       String?

  /// Powierzchnia w m². Decimal, bo 48,50 m² to nie liczba całkowita.
  areaM2 Decimal? @db.Decimal(8, 2)
  floor  Int?

  /// Czynsz wywoławczy za całą nieruchomość. Przy najmie pokojowym stawki
  /// siedzą na pokojach.
  askingRentGrosze Int?

  description String? @db.Text
  /// Notatki widoczne wyłącznie dla właściciela — nigdy dla najemcy.
  notes       String? @db.Text

  /// Czy nieruchomość pokazuje się na publicznej stronie ofert /o/<slug>.
  publiclyListed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull, nie Cascade: usunięcie właściciela nie może zabrać mieszkania
  /// razem z jego umowami i fakturami.
  owner               PropertyOwner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  rooms               Room[]
  leases              Lease[]
  photos              PropertyPhoto[]
  documents           Document[]
  meterReadings       MeterReading[]
  maintenanceRequests MaintenanceRequest[]
  expenses            Expense[]

  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, city])
  @@index([organizationId, status])
  @@index([ownerId])
  @@map("properties")
}

model PropertyPhoto {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  caption    String?
  /// Kolejność wyświetlania w galerii; pierwsze zdjęcie jest okładką.
  position   Int     @default(0)

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_photos")
}

/// Pojedynczy pokój w nieruchomości — osobny przedmiot najmu.
///
/// Pokoje powstają automatycznie przy zakładaniu nieruchomości, z podanej
/// liczby pokoi. Wynajem całości oznacza po prostu umowę bez wskazanego
/// pokoju — pokoje i tak istnieją, żeby było widać, co jest w środku.
///
/// Świadomie bez powierzchni: przy pokoju nikt jej nie rozlicza, a pole,
/// którego nikt nie wypełnia, tylko zaśmieca formularz.
model Room {
  id             String       @id @default(cuid())
  organizationId String
  propertyId     String
  /// Oznaczenie pokoju: "1", "Pokój od ogrodu", "A".
  name           String
  /// Kolejność wyświetlania — pokoje mają iść tak, jak je ponumerowano.
  position       Int          @default(0)
  status         RentalStatus @default(AVAILABLE)

  /// Czynsz za sam pokój. Umowa może go nadpisać — to cena wywoławcza.
  monthlyRentGrosze Int?

  notes String? @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases              Lease[]
  meterReadings       MeterReading[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, name])
  @@index([organizationId])
  @@index([propertyId, position])
  @@index([propertyId, status])
  @@map("rooms")
}

// ═══════════════════════════════════════════════════════════════════════════
// Najemcy
// ═══════════════════════════════════════════════════════════════════════════

enum TenantStatus {
  PROSPECT // zainteresowany, jeszcze bez umowy
  ACTIVE // ma aktywną umowę
  FORMER // umowa zakończona
}

model Tenant {
  id             String       @id @default(cuid())
  organizationId String
  status         TenantStatus @default(PROSPECT)

  firstName String
  lastName  String
  email     String?
  phone     String?

  /// Konto w panelu najemcy. NULL, dopóki właściciel nie wyśle zaproszenia —
  /// najemca może istnieć w systemie bez własnego logowania.
  userId String? @unique

  /// Adres korespondencyjny — trafia na fakturę jako dane nabywcy.
  street     String?
  postalCode String?
  city       String?
  /// NIP, gdy najemcą jest firma. Dla osoby fizycznej zostaje NULL.
  taxId      String?

  /// Dokumenty tożsamości — wszystkie opcjonalne i niezależne od siebie.
  /// Właściciel spisuje je z okazanego dokumentu przy podpisaniu umowy, a co
  /// okaże najemca, zależy od niego: Polak zwykle dowód, cudzoziemiec paszport.
  /// PESEL bywa potrzebny osobno — wchodzi do wniosku o najem okazjonalny.
  /// Karta pobytu stoi obok paszportu, a nie zamiast niego: cudzoziemiec
  /// mieszkający tu na stałe okazuje zwykle oba dokumenty naraz.
  idCardNumber        String?
  pesel               String?
  passportNumber      String?
  residenceCardNumber String?

  /// Osoba do kontaktu w nagłym wypadku. Osobne kolumny, nie relacja:
  /// to notatka na wypadek pożaru czy pogotowia, a nie kartoteka kolejnego
  /// człowieka w systemie — nie ma czego z nią łączyć ani czym rozliczać.
  emergencyContactFirstName String?
  emergencyContactLastName  String?
  emergencyContactPhone     String?
  emergencyContactEmail     String?

  /// Jaki dokument wystawiamy temu najemcy przy naliczaniu czynszu.
  /// BILL zostawia decyzję stawkom VAT (rachunek albo faktura), CHARGE oznacza
  /// samo naliczenie, które dowodem księgowym nie jest.
  documentKind InvoiceKind @default(BILL)

  notes String? @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  leases              LeaseTenant[]
  invoices            Invoice[]
  messageThreads      MessageThread[]
  maintenanceRequests MaintenanceRequest[]
  documents           Document[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastName])
  @@map("tenants")
}

// ═══════════════════════════════════════════════════════════════════════════
// Umowy najmu
// ═══════════════════════════════════════════════════════════════════════════

enum LeaseStatus {
  DRAFT // szkic, jeszcze nie podpisana
  ACTIVE // obowiązuje
  TERMINATED // wypowiedziana przed terminem
  EXPIRED // wygasła w terminie
}

/// Sposób rozliczania mediów — determinuje, czy faktura dolicza zaliczkę,
/// czy pozycje wyliczane z odczytów liczników.
enum UtilitiesMode {
  INCLUDED // media w czynszu
  FLAT_RATE // stała zaliczka
  METERED // wg odczytów liczników
  MIXED // zaliczka + rozliczenie z odczytów
}

model Lease {
  id             String      @id @default(cuid())
  organizationId String
  propertyId     String
  /// Gdy ustawione, przedmiotem najmu jest ten pokój, a nie cała nieruchomość.
  /// `propertyId` zostaje wypełnione także wtedy — dzięki temu droga do
  /// nieruchomości jest zawsze taka sama i zapytania nie rozgałęziają się
  /// na dwa warianty.
  roomId         String?
  status         LeaseStatus @default(DRAFT)

  /// Numer umowy widoczny na dokumencie, np. "2026/08/01".
  number String?

  startDate DateTime
  /// NULL = umowa na czas nieokreślony.
  endDate   DateTime?

  rentGrosze    Int
  depositGrosze Int @default(0)

  utilitiesMode           UtilitiesMode @default(FLAT_RATE)
  /// Zaliczka na media przy FLAT_RATE i MIXED.
  utilitiesAdvanceGrosze  Int           @default(0)

  /// Dzień miesiąca, w którym wystawiana jest faktura (1–28; nie 29–31,
  /// żeby luty nie wymagał wyjątku).
  billingDay      Int @default(1)

  /// Data, przed którą nie naliczamy nic z tej umowy. NULL = naliczaj od początku.
  ///
  /// Dla umów przeniesionych z innego programu: najem trwa od czerwca i tak ma
  /// zostać w kartotece — proporcje, umowa w PDF i odliczanie dni do końca liczą
  /// się od prawdziwej daty — ale dokumenty za czerwiec i lipiec wystawił już
  /// poprzedni system. Bez tego pola jedynym wyjściem było przesunięcie
  /// `startDate`, czyli skłamanie o umowie, albo trzymanie jej w szkicu do
  /// pierwszego naliczenia.
  ///
  /// Odcina całe okresy, nie dni: pomijamy każdy miesiąc, którego okres zaczyna
  /// się przed tą datą. Dokument obejmujący dni sprzed przejęcia rozliczeń
  /// dublowałby ten z poprzedniego programu, więc w praktyce wpisuje się tu
  /// pierwszy dzień miesiąca, od którego rozliczasz najemcę w Rentiksie.
  billingStartsAt DateTime?

  /// Ile dni od wystawienia na zapłatę.
  paymentTermDays Int @default(10)

  /// Czy dokumenty z tej umowy wychodzą najemcy mailem.
  ///
  /// Per umowa, nie per organizacja: jeden najemca prosi o papier albo rozlicza
  /// się przez zarządcę budynku, a reszta portfela ma dostawać maile normalnie.
  /// Wyłączenie zatrzymuje automat — ręczne „wyślij" pozostaje dostępne, bo to
  /// osobne, świadome kliknięcie.
  sendInvoicesByEmail Boolean @default(true)

  terminatedAt     DateTime?
  terminationNote  String?   @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Umowa schowana z listy roboczej — wypowiedziana albo wygasła, a jej
  /// faktury i historia rozliczeń zostają nietknięte.
  archivedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  tenants      LeaseTenant[]
  invoices     Invoice[]
  documents    Document[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([roomId])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  // Dashboard pyta „które umowy kończą się w najbliższych 60 dniach".
  @@index([organizationId, endDate])
  @@map("leases")
}

/// Najemcy na umowie. Tabela łącząca, a nie pole `tenantId` na umowie, bo pary
/// podpisujące razem to norma — i tak byłby potrzebny drugi mechanizm.
model LeaseTenant {
  id       String  @id @default(cuid())
  leaseId  String
  tenantId String
  /// Główny najemca: adresat faktur i powiadomień. Dokładnie jeden na umowę
  /// (pilnowane w kodzie — Postgres nie wyrazi tego indeksem częściowym
  /// przez Prismę bez migracji ręcznej).
  isPrimary Boolean @default(true)

  createdAt DateTime @default(now())

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([leaseId, tenantId])
  @@index([tenantId])
  @@map("lease_tenants")
}

// ═══════════════════════════════════════════════════════════════════════════
// Faktury i płatności
// ═══════════════════════════════════════════════════════════════════════════

/// Stan rozliczenia faktury.
///
/// ŚWIADOMIE NIE MA TU STATUSU „ZALEGŁA". Zaległość to funkcja czasu
/// (`dueDate < dziś && status != PAID`), a nie zapisany stan — trzymanie jej
/// w kolumnie wymagałoby crona przestawiającego statusy o północy i i tak
/// bywałoby nieaktualne. Wyliczamy ją w `src/lib/invoices/status.ts`,
/// a indeks (organizationId, status, dueDate) sprawia, że filtr jest tani.
enum InvoiceStatus {
  DRAFT // szkic, nie trafił do najemcy
  ISSUED // wystawiona
  PARTIALLY_PAID // wpłata częściowa
  PAID // rozliczona
  CANCELLED // anulowana / skorygowana do zera
}

/// Najem mieszkaniowy jest zwolniony z VAT (art. 43 ust. 1 pkt 36 ustawy
/// o VAT), więc większość właścicieli wystawia rachunek, nie fakturę VAT.
enum InvoiceKind {
  BILL // rachunek
  VAT_INVOICE // faktura VAT
  PROFORMA // proforma
  /// Naliczenie — informacja o kwocie do zapłaty. NIE jest dowodem księgowym,
  /// więc biegnie własną numeracją i nie zajmuje numerów w rejestrze rachunków
  /// ani faktur. Dla najemcy, który dokumentu do księgowości nie potrzebuje.
  CHARGE
}

/// Stawki w rozbiciu wymaganym przez FA(2).
enum VatRate {
  ZW // zwolniony
  NP // nie podlega
  RATE_0
  RATE_5
  RATE_8
  RATE_23
}

/// Status wysyłki do Krajowego Systemu e-Faktur. Integracji nie ma — pole
/// istnieje, żeby jej dołożenie nie wymagało migracji na żywej bazie.
enum KsefStatus {
  NOT_SENT
  PENDING
  ACCEPTED
  REJECTED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  /// NULL dla faktur jednorazowych, niepowiązanych z umową (np. kaucja).
  leaseId        String?
  /// Nabywca dokumentu.
  ///
  /// Dane najemcy i tak lądują na fakturze jako `buyer*` — to migawka z chwili
  /// wystawienia i ma się nie zmieniać, gdy ktoś potem poprawi kartotekę.
  /// Migawka nie wystarcza jednak do wysyłki: adres e-mail bywa poprawiany
  /// właśnie dlatego, że był błędny. Relacja daje odbiorcę dokumentowi
  /// wystawionemu poza umową, który wcześniej nie miał go w ogóle.
  tenantId       String?
  status         InvoiceStatus @default(DRAFT)
  kind           InvoiceKind   @default(BILL)

  /// Numer dokumentu, unikalny w obrębie organizacji.
  number String

  issueDate DateTime
  /// Data sprzedaży / wykonania usługi — w FA(2) osobne pole od daty wystawienia.
  saleDate  DateTime
  dueDate   DateTime

  /// Okres, którego dotyczy rozliczenie — pokazywany na dokumencie
  /// („Czynsz za sierpień 2026").
  periodStart DateTime?
  periodEnd   DateTime?

  currency String @default("PLN")

  // Sumy w groszach. Trzymane wprost, a nie liczone z pozycji przy każdym
  // odczycie: faktura po wystawieniu jest niezmienna, a dashboard sumuje
  // tysiące rekordów i nie może za każdym razem dociągać pozycji.
  totalNetGrosze   Int @default(0)
  totalVatGrosze   Int @default(0)
  totalGrossGrosze Int @default(0)
  /// Suma wpłat. Aktualizowana w transakcji razem z zapisem płatności.
  paidGrosze       Int @default(0)

  // ── Migawka danych nabywcy ────────────────────────────────────────────────
  // Kopiowane z profilu najemcy w chwili wystawienia, a nie czytane przez
  // relację. Faktura jest dokumentem księgowym: musi pokazywać dane z dnia
  // wystawienia, nawet jeśli najemca później zmieni nazwisko czy adres.
  buyerName       String
  buyerTaxId      String?
  buyerStreet     String?
  buyerPostalCode String?
  buyerCity       String?

  notes String? @db.Text

  // ── KSeF (nieaktywne) ─────────────────────────────────────────────────────
  ksefStatus          KsefStatus @default(NOT_SENT)
  ksefReferenceNumber String?
  ksefSentAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease         Lease?         @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  payments      Payment[]
  documents     Document[]
  notifications Notification[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([leaseId])
  @@index([tenantId])
  // Główny indeks dashboardu: „nieopłacone po terminie", „nadchodzące w tym
  // tygodniu" — filtr po statusie plus sortowanie po terminie płatności.
  @@index([organizationId, status, dueDate])
  @@index([organizationId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String

  description String
  /// Ilość — Decimal, bo pozycja za media to np. 4,235 m³ wody.
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @default("szt.")

  unitPriceNetGrosze Int
  vatRate            VatRate @default(ZW)

  netGrosze   Int
  vatGrosze   Int
  grossGrosze Int

  /// Kolejność pozycji na dokumencie.
  position Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

enum PaymentMethod {
  TRANSFER // przelew
  CASH // gotówka
  CARD // karta
  DIRECT_DEBIT // polecenie zapłaty
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  amountGrosze   Int
  paidAt         DateTime
  method         PaymentMethod @default(TRANSFER)

  /// Tytuł przelewu lub identyfikator z wyciągu — do uzgadniania z bankiem.
  reference String?
  note      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, paidAt])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════════════════
// Koszty
// ═══════════════════════════════════════════════════════════════════════════

/// Kategorie kosztów najmu. Lista jest zamknięta, żeby raport dało się
/// pogrupować — wolny tekst rozjechałby się na „wspólnota", „czynsz do
/// wspólnoty" i „opłata administracyjna" oznaczające to samo.
enum ExpenseCategory {
  MORTGAGE // rata kredytu
  /// Czynsz płacony właścicielowi przy podnajmie. Osobno od MORTGAGE, bo to
  /// koszt cudzego lokalu, a nie własnego — inaczej raport nie odróżniłby
  /// mieszkania na kredyt od mieszkania wziętego w podnajem.
  RENT
  COMMUNITY_FEE // czynsz do wspólnoty lub spółdzielni
  UTILITIES // media opłacane przez właściciela
  REPAIR // naprawa i remont
  FURNISHING // wyposażenie
  INSURANCE // ubezpieczenie
  PROPERTY_TAX // podatek od nieruchomości, użytkowanie wieczyste
  INCOME_TAX // ryczałt lub PIT od najmu
  MANAGEMENT // zarządzanie, prowizja pośrednika
  ACCOUNTING // księgowość
  LEGAL // obsługa prawna
  OTHER
}

/// Jak często wraca ten sam koszt. NULL na wydatku = pozycja jednorazowa.
enum ExpenseRecurrence {
  WEEKLY // co tydzień
  MONTHLY // co miesiąc
  YEARLY // co rok
  /// Własny odstęp w dniach — dla rachunków, które nie trzymają się kalendarza
  /// (przegląd co 90 dni, opłata co 10 dni).
  CUSTOM
}

/// Wydatek właściciela. Bez tej tabeli system znał wyłącznie wpływy, więc
/// raport potrafiłby pokazać przychód, ale nigdy zysku.
model Expense {
  id             String          @id @default(cuid())
  organizationId String
  /// NULL = koszt ogólny konta (księgowość, obsługa prawna), którego nie da się
  /// przypisać do jednej nieruchomości.
  propertyId     String?
  category       ExpenseCategory @default(OTHER)

  amountGrosze Int
  /// Data poniesienia. Kasowo, tak samo jak przy wpłatach — zestawienie roczne
  /// ma się zgadzać z tym, co faktycznie wyszło z konta w danym roku.
  paidAt       DateTime

  description String
  /// Dostawca — wspólnota, wykonawca, ubezpieczyciel.
  vendor      String?
  /// Numer faktury albo rachunku od dostawcy, do uzgodnienia z dokumentami.
  documentRef String?

  notes String? @db.Text

  /// Cykliczność. NULL = koszt jednorazowy, czyli zachowanie sprzed tej zmiany.
  /// Wypełnione tylko na pozycji wpisanej ręcznie — to ona jest wzorcem, z
  /// którego naliczają się kolejne.
  recurrence          ExpenseRecurrence?
  /// Odstęp w dniach dla `CUSTOM`; przy pozostałych wartościach NULL.
  recurrenceEveryDays Int?
  /// Dzień, w którym koszt naliczy się następnym razem. Trzymany w kolumnie,
  /// a nie liczony z `paidAt`, bo przebieg musi wiedzieć, dokąd już doszedł —
  /// inaczej po każdej przerwie w cronie liczyłby ten sam miesiąc od nowa.
  recurrenceNextAt    DateTime?
  /// Wzorzec, z którego naliczono tę pozycję. NULL na wpisanych ręcznie.
  recurringFromId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull, a nie Cascade: po archiwizacji nieruchomości koszt zostaje
  /// w zestawieniu rocznym, bo pieniądze naprawdę wyszły.
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// Tak samo SetNull: skasowanie wzorca zatrzymuje naliczanie, ale nie kasuje
  /// kosztów, które już poszły z konta.
  recurringFrom Expense?  @relation("ExpenseRecurrenceSource", fields: [recurringFromId], references: [id], onDelete: SetNull)
  occurrences   Expense[] @relation("ExpenseRecurrenceSource")

  @@index([organizationId])
  // Główny indeks raportu: koszty okresu, posortowane od najnowszych.
  @@index([organizationId, paidAt])
  @@index([organizationId, category])
  @@index([propertyId])
  // Wyszukanie wzorców, którym minął termin — jedyne zapytanie przebiegu.
  @@index([organizationId, recurrenceNextAt])
  @@index([recurringFromId])
  @@map("expenses")
}

// ═══════════════════════════════════════════════════════════════════════════
// Liczniki
// ═══════════════════════════════════════════════════════════════════════════

enum MeterType {
  COLD_WATER
  HOT_WATER
  ELECTRICITY
  GAS
  HEAT
  OTHER
}

/// Kto podał odczyt — właściciel widzi, czy dane pochodzą od najemcy.
enum MeterReadingSource {
  OWNER
  TENANT
}

model MeterReading {
  id             String             @id @default(cuid())
  organizationId String
  propertyId     String
  /// Licznik przypisany do konkretnego pokoju (rzadkie — zwykle liczniki są
  /// wspólne dla całego mieszkania).
  roomId         String?
  meterType      MeterType
  /// Numer licznika — jednostka może mieć dwa liczniki tego samego typu.
  meterSerial    String?
  source         MeterReadingSource @default(OWNER)

  /// Stan licznika. Decimal(12,3): wodomierze podają trzy miejsca po przecinku.
  value  Decimal  @db.Decimal(12, 3)
  readAt DateTime

  photoUrl String?
  note     String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  // Rozliczenie mediów pyta o kolejne odczyty jednego licznika w czasie.
  @@index([propertyId, meterType, readAt])
  @@map("meter_readings")
}

// ═══════════════════════════════════════════════════════════════════════════
// Zgłoszenia usterek
// ═══════════════════════════════════════════════════════════════════════════

enum MaintenanceStatus {
  NEW // nowe
  IN_PROGRESS // w trakcie
  RESOLVED // zakończone
  CANCELLED // odrzucone
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String
  /// NULL, gdy usterka dotyczy całego mieszkania, a nie konkretnego pokoju.
  roomId         String?
  status         MaintenanceStatus   @default(NEW)
  priority       MaintenancePriority @default(NORMAL)

  title       String
  description String @db.Text

  /// Kto zgłosił — konto najemcy albo właściciela.
  reportedByUserId String?
  /// Profil najemcy, jeśli zgłoszenie przyszło z panelu najemcy.
  tenantId         String?

  /// Przypisany użytkownik konta (pracownik zarządcy)…
  assignedToUserId String?
  /// …albo wykonawca zewnętrzny, który konta nie ma.
  assigneeName     String?
  assigneeContact  String?

  /// Koszt naprawy — do raportu rentowności nieruchomości.
  costGrosze Int?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy   User?              @relation("MaintenanceReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  assignedTo   User?              @relation("MaintenanceAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  photos       MaintenancePhoto[]

  @@index([organizationId])
  // Tablica kanban: kolumny po statusie, w każdej sortowanie po priorytecie.
  @@index([organizationId, status, priority])
  @@index([propertyId])
  @@index([roomId])
  @@map("maintenance_requests")
}

model MaintenancePhoto {
  id        String  @id @default(cuid())
  requestId String
  url       String
  caption   String?
  position  Int     @default(0)

  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, position])
  @@map("maintenance_photos")
}

// ═══════════════════════════════════════════════════════════════════════════
// Komunikacja
// ═══════════════════════════════════════════════════════════════════════════

/// Wątek rozmowy właściciel ↔ najemca. Osobna encja, a nie płaska lista
/// wiadomości: skrzynka sortuje po `lastMessageAt` i liczy nieprzeczytane,
/// a bez wątku każde otwarcie listy skanowałoby wszystkie wiadomości.
model MessageThread {
  id             String @id @default(cuid())
  organizationId String
  tenantId       String

  subject String?

  /// Denormalizowane pod sortowanie skrzynki — ustawiane w tej samej
  /// transakcji co zapis wiadomości.
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  closedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, lastMessageAt])
  @@index([tenantId])
  @@map("message_threads")
}

model Message {
  id             String @id @default(cuid())
  organizationId String
  threadId       String
  senderUserId   String

  body String @db.Text

  /// Kiedy odbiorca przeczytał. NULL = nieprzeczytana.
  readAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([organizationId, readAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// Dokumenty
// ═══════════════════════════════════════════════════════════════════════════

enum DocumentType {
  LEASE_AGREEMENT // umowa najmu
  ANNEX // aneks
  HANDOVER_PROTOCOL // protokół zdawczo-odbiorczy
  INVOICE_PDF // wygenerowany PDF faktury
  ID_SCAN // skan dokumentu tożsamości
  OTHER
}

enum SignatureStatus {
  NOT_REQUIRED
  PENDING
  SIGNED
  DECLINED
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  type           DocumentType @default(OTHER)

  name        String
  fileUrl     String
  mimeType    String?
  sizeBytes   Int?
  /// TRUE dla dokumentów wygenerowanych przez Rentix (umowa z kreatora),
  /// FALSE dla wgranych ręcznie.
  generated   Boolean @default(false)

  signatureStatus SignatureStatus @default(NOT_REQUIRED)
  signedAt        DateTime?

  // Dokument wisi przy jednej z encji. Wszystkie opcjonalne, bo protokół
  // dotyczy jednostki, umowa — umowy, a skan dowodu — najemcy.
  propertyId String?
  roomId     String?
  leaseId    String?
  tenantId   String?
  invoiceId  String?

  uploadedByUserId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, type])
  @@index([leaseId])
  @@index([tenantId])
  @@index([propertyId])
  @@map("documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// Powiadomienia
// ═══════════════════════════════════════════════════════════════════════════

enum NotificationType {
  PAYMENT_REMINDER // przypomnienie przed terminem
  PAYMENT_OVERDUE // zaległość
  INVOICE_ISSUED // wystawiono fakturę
  MAINTENANCE_UPDATE // zmiana statusu zgłoszenia
  MESSAGE_RECEIVED // nowa wiadomość
  LEASE_EXPIRING // kończąca się umowa
  METER_READING_REQUEST // prośba o odczyt licznika
}

enum NotificationChannel {
  EMAIL
  IN_APP
  /// Nieużywany — kanał istnieje pod przyszłą aplikację mobilną.
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  /// Odbiorca. Powiadomienia dla najemcy bez konta idą tylko na e-mail,
  /// więc pole jest opcjonalne.
  userId         String?
  type           NotificationType
  channel        NotificationChannel @default(EMAIL)
  status         NotificationStatus  @default(PENDING)

  title String
  body  String @db.Text

  /// Adres, na który poszedł e-mail — zapisany, bo profil może się zmienić.
  toEmail String?

  /// Faktura, której dotyczy przypomnienie. Najczęstszy przypadek, więc jako
  /// zwykła relacja zamiast pary (entityType, entityId).
  invoiceId String?

  sentAt DateTime?
  readAt DateTime?
  /// Treść błędu z bramki e-mail, gdy status = FAILED.
  error  String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, readAt])
  // Kolejka wysyłki: „co czeka na wysłanie".
  @@index([status, createdAt])
  @@map("notifications")
}

/// Treść powiadomienia napisana przez wynajmującego.
///
/// Puste pole znaczy „użyj domyślnego tekstu z kodu", a nie „wyślij pustkę".
/// Domyślek świadomie nie kopiujemy do bazy przy zakładaniu konta: gdyby tam
/// wylądowały, poprawka literówki w domyślnym tekście nigdy nie dotarłaby do
/// kont założonych wcześniej.
///
/// Edytowalne są tylko cztery pola — temat, nadpis i dwa akapity. Tabela
/// z numerem, kwotą i terminem zostaje po stronie systemu, bo to dane
/// z dokumentu, a nie tekst; rama HTML zostaje, bo musi się nie rozsypać
/// w Outlooku. Patrz `src/lib/email/templates.ts`.
model EmailTemplate {
  id             String           @id @default(cuid())
  organizationId String
  type           NotificationType

  subject String?
  heading String?
  intro   String? @db.Text
  outro   String? @db.Text

  /// Czy powiadomienie wychodzi **automatycznie**.
  ///
  /// Ręcznej wysyłki z panelu nie blokuje: tam wynajmujący właśnie kliknął
  /// „wyślij", więc odmowa z powołaniem na ustawienie automatu byłaby
  /// odmawianiem wykonania polecenia, które ktoś przed chwilą wydał.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@map("email_templates")
}

// ═══════════════════════════════════════════════════════════════════════════
// Subskrypcja
// ═══════════════════════════════════════════════════════════════════════════

enum SubscriptionPlan {
  FREE // do 20 najemców
  PRO // bez limitu
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id             String             @id @default(cuid())
  /// Jedna subskrypcja na organizację.
  organizationId String             @unique
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)

  /// Limity zapisane wprost, a nie wyprowadzane z `plan`. Dzięki temu da się
  /// podnieść limit pojedynczemu klientowi bez dokładania nowego planu.
  tenantLimit   Int? @default(20)
  propertyLimit Int?

  /// Konto zwolnione z opłat: korzysta z planu, ale nie jest obciążane.
  ///
  /// Osobna flaga, a nie plan „PRO za darmo” — plan mówi, co konto może robić,
  /// a to pole, czy w ogóle trafia do rozliczenia. Bez tego rozdziału konta
  /// wewnętrzne (własna firma, demo, partner) szłyby do operatora płatności
  /// razem z klientami i dostawały wezwania do zapłaty.
  billingExempt Boolean @default(false)

  currentPeriodEnd DateTime?
  cancelledAt      DateTime?

  /// Identyfikatory u operatora płatności (Stripe / Przelewy24) — puste,
  /// dopóki nie ma integracji.
  externalCustomerId     String?
  externalSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}
