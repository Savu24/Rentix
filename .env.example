# ── Baza danych ────────────────────────────────────────────────────────────────
# Prisma 7 łączy się przez driver adapter `@prisma/adapter-pg`, więc potrzebny
# jest zwykły connection string PostgreSQL — ten sam format lokalnie i na produkcji.
#
#   Neon:      postgresql://user:haslo@ep-xxx.eu-central-1.aws.neon.tech/rentix?sslmode=require
#   Supabase:  postgresql://postgres.xxx:haslo@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
#   Lokalnie:  postgresql://postgres:haslo@localhost:5432/rentix
#
# Supabase wymaga `uselibpqcompat=true` — bez tego `pg` weryfikuje łańcuch
# certyfikatów jak przy `verify-full` i połączenie pada na self-signed CA.
DATABASE_URL="postgresql://user:haslo@host:5432/rentix?sslmode=require"

# Połączenie sesyjne wyłącznie do migracji. Potrzebne TYLKO na serverless
# (Vercel), gdzie DATABASE_URL wskazuje transaction pooler na porcie 6543 —
# ten nie obsługuje instrukcji wymaganych przez `prisma migrate deploy`.
# Na hostingu z jednym procesem zostaw puste.
#   Vercel + Supabase:
#     DATABASE_URL  → ...pooler.supabase.com:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
#     DIRECT_URL    → ...pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DIRECT_URL=""

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Wygeneruj: npx auth secret   (albo dowolne 32 losowe bajty w base64)
AUTH_SECRET="zmien-mnie-na-losowy-sekret"
# Publiczny URL aplikacji. Lokalnie http://localhost:3000.
# Na Vercelu ustawia się sam; na Render podaj adres serwisu.
AUTH_URL="http://localhost:3000"
# Ustaw na "true", jeśli aplikacja stoi za proxy (Render, nginx) i ma zaufać X-Forwarded-*
AUTH_TRUST_HOST="true"

# ── E-mail transakcyjny (Resend) ──────────────────────────────────────────────
# Bez klucza przypomnienia o płatnościach nie wychodzą: próba wysyłki jest
# zapisywana w tabeli `notifications` ze statusem FAILED i zostaje ponowiona
# przy kolejnym przebiegu, gdy klucz się pojawi.
RESEND_API_KEY=""
EMAIL_FROM="Rentix <no-reply@rentix.pl>"

# ── Alternatywa: zwykły SMTP ──────────────────────────────────────────────────
# Zamiast Resendu można wysyłać z istniejącej skrzynki — wtedy nie trzeba
# konfigurować rekordów DNS własnej domeny, bo adres, którego używasz, ma je
# już ustawione. Gdy ustawione są OBIE drogi, wygrywa Resend.
#
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#           SMTP_USER=twoj@gmail.com  SMTP_PASSWORD=<hasło aplikacji, nie hasło do konta>
#           EMAIL_FROM="Twoje Imię <twoj@gmail.com>"   ← musi być TEN SAM adres
#
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#           SMTP_USER i SMTP_PASSWORD z panelu Brevo (SMTP & API)
#
# Wszystkie trzy pola razem albo żadne — niepełny komplet wywali start
# aplikacji z czytelnym komunikatem zamiast po cichu wyłączyć pocztę.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Publiczny adres aplikacji — baza dla odnośników w metadanych stron.
# Gdy pusty, używany jest AUTH_URL. Dokumenty jadą do najemcy jako załącznik
# PDF, nie linkiem, więc poczta z tej zmiennej nie korzysta.
APP_URL="http://localhost:3000"

# ── Limiter prób logowania (Upstash Redis) ────────────────────────────────────
# Bez tych dwóch zmiennych licznik prób siedzi w pamięci procesu. Na serverless
# każda instancja ma wtedy własny, wyzerowany licznik, więc "5 prób na 15 minut"
# zamienia się w "5 prób na instancję" — czyli brak ochrony przed zgadywaniem
# haseł. Lokalnie można je zostawić puste.
# Darmowy plan: https://upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Naliczanie cykliczne ──────────────────────────────────────────────────────
# Wspólny sekret endpointu /api/cron/billing (nagłówek: Authorization: Bearer …).
# Bez niego endpoint jest wyłączony — naliczanie czynszu nie może być otwarte
# dla świata. Wygeneruj: npx auth secret
#
# Harmonogram woła ten endpoint z GitHub Actions (.github/workflows/billing.yml),
# więc tę samą wartość trzeba wpisać w sekretach repozytorium jako CRON_SECRET,
# a adres aplikacji jako APP_URL.
CRON_SECRET=""
