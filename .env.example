# ── Baza danych ────────────────────────────────────────────────────────────────
# Prisma 7 łączy się przez driver adapter `@prisma/adapter-pg`, więc potrzebny
# jest zwykły connection string PostgreSQL — ten sam format lokalnie i na produkcji.
#
#   Neon:      postgresql://user:haslo@ep-xxx.eu-central-1.aws.neon.tech/rentix?sslmode=require
#   Supabase:  postgresql://postgres.xxx:haslo@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
#   Lokalnie:  postgresql://postgres:haslo@localhost:5432/rentix
#
# Supabase wymaga `uselibpqcompat=true` — bez tego `pg` weryfikuje łańcuch
# certyfikatów jak przy `verify-full` i połączenie pada na self-signed CA.
DATABASE_URL="postgresql://user:haslo@host:5432/rentix?sslmode=require"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Wygeneruj: npx auth secret   (albo dowolne 32 losowe bajty w base64)
AUTH_SECRET="zmien-mnie-na-losowy-sekret"
# Publiczny URL aplikacji. Lokalnie http://localhost:3000.
# Na Vercelu ustawia się sam; na Render podaj adres serwisu.
AUTH_URL="http://localhost:3000"
# Ustaw na "true", jeśli aplikacja stoi za proxy (Render, nginx) i ma zaufać X-Forwarded-*
AUTH_TRUST_HOST="true"

# ── E-mail transakcyjny (Resend) ──────────────────────────────────────────────
# Bez klucza przypomnienia o płatnościach nie wychodzą: próba wysyłki jest
# zapisywana w tabeli `notifications` ze statusem FAILED i zostaje ponowiona
# przy kolejnym przebiegu, gdy klucz się pojawi.
RESEND_API_KEY=""
EMAIL_FROM="Rentix <no-reply@rentix.pl>"

# Adres, pod którym najemca otwiera dokument z linku w e-mailu.
# Gdy pusty, używany jest AUTH_URL; gdy oba puste, wiadomość idzie bez przycisku.
APP_URL="http://localhost:3000"

# ── Naliczanie cykliczne ──────────────────────────────────────────────────────
# Wspólny sekret endpointu /api/cron/billing (nagłówek: Authorization: Bearer …).
# Bez niego endpoint jest wyłączony — naliczanie czynszu nie może być otwarte
# dla świata. Wygeneruj: npx auth secret
CRON_SECRET=""
